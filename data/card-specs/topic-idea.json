    {
      "key": "status",
      "label": "状态",
      "type": "enum",
      "required": true,
      "options": [
        {
          "value": "idea",
          "label": "想法"
        },
        {
          "value": "drafting",
          "label": "在写"
        },
        {
          "value": "scheduled",
          "label": "待发"
        },
        {
          "value": "published",
          "label": "已发"
        },
        {
          "value": "dropped",
          "label": "废弃"
        }
      ]
    },
    {
      "key": "score",
      "label": "自评",
      "type": "number",
      "unit": "分",
      "hint": "1-5，低于 3 分的题不值得占排期"
    },
    {
      "key": "tags",
      "label": "标签",
      "type": "tags",
      "max": 8
    },
    {
      "key": "createdAt",
      "label": "记于",
      "type": "date"
    }
  ],
