        },
        {
          "value": "douyin",
          "label": "抖音"
        },
        {
          "value": "podcast",
          "label": "播客"
        },
        {
          "value": "youtube",
          "label": "YouTube"
        },
        {
          "value": "twitter",
          "label": "X"
        },
        {
          "value": "rss",
          "label": "RSS"
        }
