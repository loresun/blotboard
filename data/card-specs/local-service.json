{
  "id": "local-service",
  "version": 1,
  "name": "本地服务",
  "category": "record",
  "icon": "package",
  "description": "一个常驻在本机的服务：端口、pm2 名、代码在哪、干什么用",
  "tags": [
    "运维",
    "端口"
  ],
  "source": {
    "app": "local",
    "hint": "pm2 jlist / 各项目 README 里那几行"
  },
  "card": {
    "w": 340,
    "h": 260,
    "color": "blue"
  },
  "display": {
    "title": "name",
    "subtitle": "pm2",
    "body": "purpose",
    "badges": [
      "port",
      "status"
    ],
    "link": "url",
    "time": "checkedAt"
  },
  "fields": [
    {
      "key": "name",
      "label": "服务名",
      "type": "text",
      "required": true,
      "max": 60
    },
    {
      "key": "port",
      "label": "端口",
      "type": "number",
      "required": true
    },
    {
      "key": "pm2",
      "label": "pm2",
      "type": "text",
      "max": 60,
      "hint": "重启用：pm2 restart <名字>"
    },
    {
      "key": "repo",
      "label": "代码路径",
      "type": "text",
      "required": true,
      "max": 200
    },
    {
      "key": "entry",
      "label": "启动入口",
      "type": "text",
      "max": 120,
      "hint": "如 run.py / server.mjs / npm run dev"
    },
    {
      "key": "status",
      "label": "状态",
      "type": "enum",
      "options": [
        {
          "value": "online",
          "label": "在跑"
        },
        {
          "value": "stopped",
          "label": "停了"
        },
        {
          "value": "degraded",
          "label": "半死"
        }
      ]
    },
    {
      "key": "purpose",
      "label": "干什么用",
      "type": "longtext",
      "required": true,
      "max": 1500,
      "hint": "一句话说清它解决什么，别抄 README 首段"
    },
    {
      "key": "url",
      "label": "访问地址",
      "type": "url"
    },
    {
      "key": "health",
      "label": "健康检查",
      "type": "text",
      "max": 120,
      "hint": "如 GET /api/health，或一条 curl"
    },
    {
      "key": "gotcha",
      "label": "踩过的坑",
      "type": "longtext",
      "max": 1500,
      "hint": "改完要重启？端口会被占？登录态会过期？写这里"
    },
    {
      "key": "checkedAt",
      "label": "最后核对",
      "type": "date"
    }
  ],
  "example": {
    "name": "示例知识库",
    "port": 8000,
    "pm2": "example-kb",
    "repo": "~/projects/example-kb",
    "entry": "run.py",
    "status": "online",
    "purpose": "知识库 / RAG：多条采集线入库，向量+混合检索，给 agent 当资料源。",
    "url": "http://127.0.0.1:8000",
    "health": "GET /api/status",
    "gotcha": "改完代码要 pm2 restart example-kb 才生效（不自动 reload）。",
    "checkedAt": "2026-08-26T00:00:00Z"
  }
}
